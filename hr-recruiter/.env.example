# hr-recruiter environment template
# Copy to .env and adjust.

# MongoDB connection (local or Atlas)
MONGODB_URI=mongodb://localhost:27017

# This app's own database (recruiters, job_postings, applications)
DB_NAME=hr_recruiter

# Component 4's database + collection, read-only (skill-gap reports).
# C4 writes into the shared global DB (recruit_ai), so reports follow it.
REPORTS_DB=recruit_ai
REPORTS_COLLECTION=skill_gap_reports

# JWT signing
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
