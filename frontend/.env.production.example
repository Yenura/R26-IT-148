# Build-time API origins for the deployed frontend.
#
# Copy to frontend/.env.production (git-ignored) and replace the hostnames with
# your own.  `vite build` loads this automatically in production mode; without
# it the bundle falls back to http://127.0.0.1:8000-8004 and every deployed
# visitor's browser tries to call their own machine.
#
# These are the five Cloudflare Tunnel hostnames, one per backend service.
# Only the origin is needed: api.js appends /api/v1 itself and strips it if you
# include it by mistake.

VITE_C0_URL=https://c0.example.com
VITE_C1_URL=https://c1.example.com
VITE_C2_URL=https://c2.example.com
VITE_C3_URL=https://c3.example.com
VITE_C4_URL=https://c4.example.com
