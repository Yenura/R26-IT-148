# Component 4 — Environment Variables Template
# Copy this file to .env and fill in the values

# MongoDB Atlas or local connection string
MONGODB_URI=mongodb://localhost:27017

# Database name inside MongoDB (shared global DB across all components)
DB_NAME=recruit_ai

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
