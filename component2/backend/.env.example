# Environment variables for Component 2
# Copy to .env and update as needed

# API Configuration
API_HOST=0.0.0.0
API_PORT=8002
API_RELOAD=true
API_LOG_LEVEL=info

# Models Directory
MODELS_DIR=c:/Users/ASUS/OneDrive/Documents/GitHub/R26-IT-148/component2/models

# Database (if using)
DATABASE_URL=mongodb://localhost:27017/interview_system
# Or for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/interview_db

# CORS Settings
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Component Integration
COMPONENT1_URL=http://localhost:8001
COMPONENT3_URL=http://localhost:8003
COMPONENT4_URL=http://localhost:8004

# ML Model Configuration
SBERT_MODEL=all-MiniLM-L6-v2
MCQ_PENALTY=0.25
TEST_WEIGHT_FOR_CODING=0.7

# Feature Flags
ENABLE_TIME_PENALTY=true
ENABLE_NEGATIVE_MARKING=true
ENABLE_CODE_QUALITY_CHECK=true
