# RecruitAI Master Environment Configuration
# Copy this file to .env and fill in real values:
#   copy .env.example .env
#
# .env is git-ignored; this template is not.  Never put a real credential or
# secret in this file -- see the note at the bottom.

# Local MongoDB from the docker-compose stack.  To use a hosted cluster
# (e.g. Atlas) instead, comment this out and put your own connection string
# here -- never a real one in this template:
MONGODB_URI=mongodb://mongodb:27017
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/HR
DB_NAME=HR

# Signs every session token.  Generate your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Shared between the services for internal calls.  Whatever you choose, every
# service in .env must use the same value or inter-service calls start failing.
INTERNAL_API_KEY=change-me-shared-across-services

# ── Cloudflare deployment ──────────────────────────────────────────────
# Only needed for the tunnel overlays in deploy/cloudflare/.  See
# deploy/cloudflare/README.md for the full runbook.

# The tunnel's token, from Zero Trust -> Networks -> Tunnels -> your tunnel.
# Used by docker-compose.tunnel.yml.  Keep it out of git.
TUNNEL_TOKEN=

# What the browser is allowed to call.  This must be the deployed frontend
# origin, or the frontend loads but every API call is blocked by CORS.
# For the tunnel deployment it is the Cloudflare Pages domain, e.g.
#   ALLOWED_ORIGINS=https://app.example.com
# The frontend build needs the same hostnames in its VITE_*_URL variables --
# see frontend/.env.production.example.  Those are baked into the bundle at
# build time, not looked up at runtime:
#   VITE_C0_URL=https://c0.example.com     (unified backend, port 8000)
#   VITE_C1_URL=https://c1.example.com     (CV analysis, port 8001)
#   VITE_C2_URL=https://c2.example.com     (AI interview, port 8002)
#   VITE_C3_URL=https://c3.example.com     (ranking, port 8003)
#   VITE_C4_URL=https://c4.example.com     (skill gap, port 8004)

# ───────────────────────────────────────────────────────────────────────
# SECURITY NOTE -- read before making this repository public.
#
# This template previously carried a live-looking MongoDB Atlas connection
# string (mongodb+srv://admin:<password>@coordinator.ljarc.mongodb.net/HR) and
# a shared INTERNAL_API_KEY.  Because .env.example is tracked by git, both have
# been readable by anyone with the repository since commit f5b5acf, and they
# remain in the history even though this file no longer contains them.
#
# If that cluster is still up: rotate its database user password now
# (Atlas -> Database Access) and treat the old one as public.  Do the same for
# the internal API key.  Anything committed once should be considered leaked,
# and rewriting history does not un-leak it.
# ───────────────────────────────────────────────────────────────────────
